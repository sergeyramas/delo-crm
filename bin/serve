#!/usr/bin/env python3
"""Слушает только loopback. Секреты берёт из окружения и, если ключа ещё нет, из .env."""

from __future__ import annotations

import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))


def load_env(path: Path) -> None:
    if not path.is_file():
        return
    for line in path.read_text(encoding="utf-8").splitlines():
        raw = line.strip()
        if not raw or raw.startswith("#") or "=" not in raw:
            continue
        key, value = raw.split("=", 1)
        os.environ.setdefault(key.strip(), value.strip())


def main() -> None:
    load_env(ROOT / ".env")
    host = os.environ.get("HOST", "127.0.0.1").strip() or "127.0.0.1"
    port_raw = os.environ.get("PORT", "8091").strip() or "8091"
    try:
        port = int(port_raw)
    except ValueError:
        sys.stderr.write("PORT должен быть числом.\n")
        sys.exit(2)
    if host not in {"127.0.0.1", "localhost", "::1"}:
        sys.stderr.write(
            f"Отказ слушать {host}. CRM доступна только с 127.0.0.1, снаружи её открывает nginx.\n"
        )
        sys.exit(2)
    if not 1 <= port <= 65535:
        sys.stderr.write("PORT вне диапазона.\n")
        sys.exit(2)
    # Ядро ~1.8G. Один процесс, без воркеров и без reload: лишний процесс сюда не кладём.
    concurrency = _cap("LIMIT_CONCURRENCY", 20, 40)
    backlog = _cap("BACKLOG", 16, 64)
    import uvicorn

    from app.main import create_app

    uvicorn.run(
        create_app(),
        host=host,
        port=port,
        workers=1,
        limit_concurrency=concurrency,
        backlog=backlog,
        timeout_keep_alive=5,
        proxy_headers=True,
        forwarded_allow_ips="127.0.0.1",
        log_level="info",
    )


def _cap(name: str, default: int, ceiling: int) -> int:
    raw = os.environ.get(name, "").strip()
    if not raw:
        return default
    try:
        value = int(raw)
    except ValueError:
        return default
    if value < 1:
        return default
    return min(value, ceiling)


if __name__ == "__main__":
    main()
