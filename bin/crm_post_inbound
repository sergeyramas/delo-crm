#!/usr/bin/env python3
"""JSON из stdin → шлюз CRM. Для копирования на Hermes вместе с app/sync_client.py.

Секрет берётся из DELO_CRM_INBOUND_SECRET или INBOUND_SECRET. В argv его не передавать.

  crm_post_inbound inbound < payload.json
  crm_post_inbound patch Д-2026-0001 < patch.json
  crm_post_inbound event Д-2026-0001 < event.json
"""

from __future__ import annotations

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from app.sync_client import SyncError, patch_package, post_event, post_inbound


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    usage = "crm_post_inbound inbound | patch НОМЕР | event НОМЕР"
    if not args or args[0] in {"-h", "--help"}:
        print(usage, file=sys.stderr)
        return 2
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except json.JSONDecodeError:
        print("Не JSON.", file=sys.stderr)
        return 2
    if not isinstance(payload, dict):
        print("Нужен объект JSON.", file=sys.stderr)
        return 2
    try:
        if args[0] == "inbound" and len(args) == 1:
            body = post_inbound(payload)
        elif args[0] == "patch" and len(args) == 2:
            body = patch_package(args[1], payload)
        elif args[0] == "event" and len(args) == 2:
            body = post_event(args[1], payload)
        else:
            print(usage, file=sys.stderr)
            return 2
    except SyncError as exc:
        print(exc.message, file=sys.stderr)
        return 1
    json.dump(body, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
