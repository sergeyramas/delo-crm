# Скопировать в .env на сервере или в /srv/ati/secrets/delo-crm.env.
# Значения секретов сюда не писать. Кавычки не нужны.

# Слушать только loopback. Снаружи открывает nginx.
HOST=127.0.0.1
PORT=8091

# Ядро ~1.8G. Один процесс (workers=1 в bin/serve, флаг не поднимается).
# Сколько запросов uvicorn держит сразу. Выше 40 приложение само не поставит.
LIMIT_CONCURRENCY=20
BACKLOG=16

# Данные. Боевой путь: /srv/delo-crm
# Запасной из ТЗ, если Вишну кладёт дерево ati рядом: /srv/ati/delo-crm
DATA_DIR=
SQLITE_PATH=

# Секрет шлюза /s/* . Заголовок X-Inbound-Secret или поле JSON secret.
# Аналог inbox_site_secret в alpstream-crm. Пустая строка — шлюз отвечает 503.
INBOUND_SECRET=

# off — локально без пароля. basic — пароль приложения. proxy — пароль на nginx.
AUTH_MODE=off
UI_USER=
UI_PASSWORD=
UI_GATE_SECRET=
UI_DISPLAY_NAME=Андрей (логист)

# Уведомление о смене статуса. 0 — процесс к Telegram не обращается.
NOTIFY_TG=0
TG_BOT_TOKEN=
TG_CHAT_ID=

# Проверка мессенджеров по телефону карточки. off | mock | live.
# off — бейджи «неизвестно», сеть не вызывается.
# mock — заглушка для локальной проверки, сеть не вызывается.
# live — боевой адаптер ещё не подключён: сеть не вызывается (TODO Вишну).
MESSENGER_CHECK=off
MESSENGER_TG_TOKEN=
MESSENGER_WA_TOKEN=
MESSENGER_MAX_TOKEN=

# Учётки экрана. Боевые пароли только в /root/ati/secrets/delo-crm-auth.env
# Роль: admin, dispatcher или operator. Пустой пароль — строка в базе есть, войти нельзя.
DELO_USER_SERGEY_ROLE=admin
DELO_USER_SERGEY_PASSWORD=
DELO_USER_ANDREY_ROLE=admin
DELO_USER_ANDREY_PASSWORD=
