# /etc/systemd/system/delo-crm.service
# Порт по умолчанию 8091 на 127.0.0.1 хоста.
# Если в env другой PORT, поправьте upstream 172.18.0.1 в /data/nginx/user_conf.d/.
# На Ядре nginx в Docker. /etc/nginx/sites-available и systemctl reload nginx не используются.
# Секреты только в EnvironmentFile, не в этом юните.
# systemd читает файлы от root до User=delo, поэтому mode 600 в /root подходит.
# Минус перед путём: нет файла — юнит всё равно стартует.
# /srv/ati/secrets/delo-crm.env — старый путь, если файл уже лежит там.

[Unit]
Description=ATI Delo CRM
After=network.target

[Service]
Type=simple
User=delo
Group=delo
WorkingDirectory=/srv/delo-crm
EnvironmentFile=-/srv/ati/secrets/delo-crm.env
EnvironmentFile=-/root/ati/secrets/delo-crm.env
EnvironmentFile=-/root/ati/secrets/delo-crm-auth.env
ExecStart=/srv/delo-crm/.venv/bin/python bin/serve
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
# На Ядре около 1.8G на всё. CRM держим в 512M, чтобы nginx и ssh остались живы.
MemoryHigh=384M
MemoryMax=512M

[Install]
WantedBy=multi-user.target
